                    "text": "`- 現在のブランチ: ${git.branch ?? \"detached HEAD\"}（worktree の${git.inWorktree ? \"中\" : \"外\"}）`,"
                  }
                }
              }
            }
          ],
          "partialFingerprints": {
            "snippetHash": "sha256:746291d9a0b46c5c"
