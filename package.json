{
  "name": "enso",
  "private": true,
  "version": "1.0.0",
  "description": "AI-driven development framework for Claude Code",
  "scripts": {
    "prepare": "node scripts/setup-git-hooks.mjs",
    "secretlint": "secretlint --secretlintignore .gitignore \"**/*\"",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint ."
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm secretlint && pnpm check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "secretlint": "13.0.4",
    "simple-git-hooks": "2.13.1"
  },
  "packageManager": "pnpm@11.21.0"
}
